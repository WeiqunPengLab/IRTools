#!/usr/bin/env python
import os
import sys
import time
import logging
import argparse as ap

from IRTools.Constants import *


def main():
        """The Main function/pipeline for IRTools.

        """
        # Parse options...
        argparser = prepare_argparser()
        args = argparser.parse_args()

        logging.basicConfig(level=logging.DEBUG,
                            format='[%(asctime)s]: %(message)s ',
                            datefmt='%Y-%m-%d %H:%M:%S',
                            stream=sys.stdout,
                            filemode="w"
                            )    

        if args.outdir:
                # use a output directory to store IRTools output
                if not os.path.exists( args.outdir ):
                        try:
                                os.makedirs( args.outdir )
                        except:
                                sys.exit( "Output directory (%s) could not be created. Terminating program." % args.outdir )

        subcommand  = args.subcommand_name

        if subcommand == "annotation":
                from IRTools.annotation_cmd import run
                logging.info("Beginning IRTools annotation run")
                print('-' * 50)
                start_time = time.time()
                run( args )
                end_time = time.time()
                print('-' * 50)
                logging.info("Run complete: %s elapsed" % elapsed_time(start_time, end_time))
        elif subcommand == "quant":
                logging.info("Beginning IRTools quant run")
                print('-' * 50)
                start_time = time.time()
                from IRTools.quant_cmd import run
                run( args )
                end_time = time.time()
                print('-' * 50)
                logging.info("Run complete: %s elapsed" % elapsed_time(start_time, end_time))
        elif subcommand == "ont":
                logging.info("Beginning IRTools ont run")
                print('-' * 50)
                start_time = time.time()
                from IRTools.ont_cmd import run
                run( args )
                end_time = time.time()
                print('-' * 50)
                logging.info("Run complete: %s elapsed" % elapsed_time(start_time, end_time))
        elif subcommand == "diff":
                logging.info("Beginning IRTools diff run")
                print('-' * 50)
                start_time = time.time()
                from IRTools.diff_cmd import run
                run( args )
                end_time = time.time()
                print('-' * 50)
                logging.info("Run complete: %s elapsed" % elapsed_time(start_time, end_time))

        return argparser


def prepare_argparser():
        """
        Prepare optparser object. New options will be added in this function first.
        """
        description = "%(prog)s " + IRTools_VERSION + " -- a computational toolset for analysis of intron retention (IR) and read-through (RT) from short-read RNA-seq and ONT direct RNA-seq libraries"
        epilog = "For command line options of each command, type: %(prog)s COMMAND -h"
        # top-level parser
        argparser = ap.ArgumentParser( description = description, epilog = epilog )
        argparser.add_argument("-v", "--version", action="version", version="%(prog)s "+IRTools_VERSION)
        subparsers = argparser.add_subparsers( dest = 'subcommand_name' )

        # command for 'annotation'
        add_annotation_parser( subparsers )

        # command for 'quant'
        add_quant_parser( subparsers )

        # command for 'ont'
        add_ont_parser( subparsers )
        
        # command for 'diff'
        add_diff_parser( subparsers )

        return argparser


def add_outdir_option( parser ):
        parser.add_argument("--outdir", dest = "outdir", type = str, default = '',
                            help = "If specified all output files will be written to that directory. Default: the current working directory")


def add_annotation_parser( subparsers ):
        """
        Add main function 'annotation' argument parsers.
        """
        argparser_annotation = subparsers.add_parser("annotation", help="Generate annotation GTF/GFF3-derived file for intron retention and read-through analysis.", description="IRTools " + IRTools_VERSION + " -- build an intron retention and read-through annotation from GTF or GFF3.")

        # group for input files
        group_general = argparser_annotation.add_argument_group( "general arguments" )
        group_general.add_argument( "-g", "--GTF-file", dest = "inputfile", metavar = "GTFFILE", type = str, required = True,
                                  help = "Input annotation GTF or GFF3 filename. REQUIRED." )
        
        group_general.add_argument( "-o", "--annotation-file", dest = "annofile", type = str, required = True,
                                    help = "Output IRTools annotation filename. REQUIRED.")
        group_general.add_argument( "-u", "--map-file", dest = "mapfile", type = str,
                                  help = "Optional mappability resource for annotation-time IRI preprocessing. Provide a local bigWig/BED file, or specify a supported genome shortcut (hg19, hg38, mm9, mm10, mm11).")
        group_general.add_argument( "--map-read-length", dest = "mapreadlength", type = int, choices = (24, 36, 50, 100),
                                  help = "Read length used when resolving a species shortcut passed to --map-file. DEFAULT: 50.",
                                  default = 50)
        group_general.add_argument( "--map-cutoff", dest = "mapcutoff", type = float,
                                  help = "Mappability cutoff used to define low-mappability intervals. DEFAULT: 0.1.",
                                  default = 0.1)
        group_general.add_argument( "--map-cache-dir", dest = "mapcachedir", type = str,
                                  help = "Optional writable directory for generated low-mappability BED cache files. Default: IRTools/data/mappability_cache inside the installed package.")
        group_general.add_argument("--outdir", dest = "outdir", type = str, default = '',
                                   help = "If specified, all output files will be written to that directory. Default: the current working directory") 

        return


def add_quant_parser( subparsers ):
        """
        Add main function 'quant' argument parsers.
        """
        argparser_quant = subparsers.add_parser("quant", help="Quantify intron retention or read-through with IRI, IRC, or RT.", description="IRTools " + IRTools_VERSION + " -- quantify short-read RNA-seq intron retention or read-through with IRI, IRC, or RT.")

        # group for general arguments
        group_general = argparser_quant.add_argument_group( "general arguments" )
        group_general.add_argument( "-q", "--quant-type", dest = "quanttype", type = str, choices=("IRI", "IRC", "RT"),
                                  help = "Quantification types: intron retention index (IRI), intron retention coefficient (IRC), and read-through index (RT). DEFAULT: \"IRI\".",
                                  default = "IRI")        
        group_general.add_argument( "-i", "--alt-file", dest = "altfile", type = str, required = True,
                                  help = "Input short-read RNA-seq BAM file, or a quoted wildcard pattern such as \"*.bam\".")
        group_general.add_argument( "-p", "--read-type", dest = "readtype", type = str, choices = ("paired", "single"),
                                  help = "\"paired\" is for paired-end RNA-Seq libraries and \"single\" is for single-end RNA-Seq libraries. DEFAULT: \"single\".",
                                  default = "single" )   
        group_general.add_argument( "-s", "--library-type", dest = "libtype", type = str, choices = ("fr-unstranded", "fr-firststrand", "fr-secondstrand"),
                                  help = "Library type. DEFAULT: \"fr-unstranded\" (unstranded). Use \"fr-firststrand\" or \"fr-secondstrand\" for strand-specific RNA-Seq libraries.",
                                  default = "fr-unstranded" )
        group_general.add_argument( "-g", "--annotation-file", dest = "annofile", type = str, required = True,
                                   help = "IR annotation file built by \"IRTools annotation\", or a bundled genome shortcut (hg38/mm39). If the value is an existing file path, that file is used. Otherwise IRTools looks for a bundled precomputed annotation for that genome name." )
        
        group_general.add_argument( "-n", "--name", dest = "name", type = str, required = True,
                                    help = "Sample name, which will be used to generate output file names. REQUIRED.")  
        group_general.add_argument("--outdir", dest = "outdir", type = str, default = '',
                                   help = "If specified, all output files will be written to that directory. Default: the current working directory") 

        # group for IRI specific arguments
        group_IRI = argparser_quant.add_argument_group( "IRI specific arguments" )        

        # group for IRC specific arguments
        group_IRC = argparser_quant.add_argument_group( "IRC specific arguments" )
        group_IRC.add_argument( "-m", "--min_overlap", dest = "minoverlap", type = int,
                                help = "Set when IR quantification type is \"IRC\". Minimum length of overlap between the reads and each of the exons or introns involved in splicing. DEFAULT: 8.",
                                default = 8 )         

        return  


def add_ont_parser( subparsers ):
        """
        Add main function 'ont' argument parsers.
        """
        argparser_ont = subparsers.add_parser("ont", help="Calculate intron retention or read-through from ONT direct RNA-seq splice-aware BAM alignments.", description="IRTools " + IRTools_VERSION + " -- quantify ONT direct RNA-seq intron retention (IRI) or read-through (RT) from splice-aware BAM alignments.")

        group_general = argparser_ont.add_argument_group( "general arguments" )
        group_general.add_argument( "-q", "--quant-type", dest = "quanttype", type = str, choices = ("IRI", "RT"),
                                  help = "ONT quantification type: intron retention index (IRI) or read-through index (RT). DEFAULT: \"IRI\".",
                                  default = "IRI" )
        group_general.add_argument( "-i", "--alt-file", dest = "altfile", type = str, required = True,
                                  help = "Input ONT direct RNA-seq alignment BAM file, or a wildcard pattern such as \"*.bam\". Alignments should be generated with a splice-aware aligner such as minimap2." )
        group_general.add_argument( "-g", "--annotation-file", dest = "annofile", type = str, required = True,
                                   help = "IR annotation file built by \"IRTools annotation\", or a bundled genome shortcut such as hg38/mm39." )
        group_general.add_argument( "-s", "--library-type", dest = "libtype", type = str, choices = ("fr-unstranded", "fr-firststrand", "fr-secondstrand"),
                                  help = "Library type. DEFAULT: \"fr-unstranded\". Use a stranded setting when the ONT BAM strand should be interpreted relative to transcript orientation.",
                                  default = "fr-unstranded" )
        group_general.add_argument( "-n", "--name", dest = "name", type = str, required = True,
                                    help = "Sample name, which will be used to generate output file names. REQUIRED.")  
        group_general.add_argument("--outdir", dest = "outdir", type = str, default = '',
                                   help = "If specified, all output files will be written to that directory. Default: the current working directory") 

        group_ont = argparser_ont.add_argument_group( "ONT specific arguments" )
        group_ont.add_argument( "-m", "--min-overlap", dest = "minoverlap", type = int,
                                help = "For IRI event-count QC columns, minimum aligned bases inside a constitutive intronic region required to count one read as retained. This does not affect coverage-based IRI. DEFAULT: 20.",
                                default = 20 )
        group_ont.add_argument( "--splice-tolerance", dest = "splicetolerance", type = int,
                                help = "For IRI event-count QC columns, maximum distance in bp between a CIGAR N skipped interval and a constitutive intron boundary to count one read as spliced. This does not affect coverage-based IRI. DEFAULT: 10.",
                                default = 10 )
        group_ont.add_argument( "--min-mapq", dest = "minmapq", type = int,
                                help = "Minimum mapping quality for an alignment to be counted. DEFAULT: 0.",
                                default = 0 )
        group_ont.add_argument( "--include-secondary", dest = "include_secondary", action = "store_true",
                                help = "Include secondary alignments. DEFAULT: secondary alignments are skipped." )
        group_ont.add_argument( "--include-supplementary", dest = "include_supplementary", action = "store_true",
                                help = "Include supplementary alignments. DEFAULT: supplementary alignments are skipped." )
        group_ont.add_argument( "--require-unique", dest = "require_unique", action = "store_true",
                                help = "Require NH=1 when the NH tag exists. DEFAULT: do not require NH=1." )

        return


def add_diff_parser( subparsers ):
        """
        Add main function 'diff' argument parsers.
        """
        argparser_diff = subparsers.add_parser("diff", help="Compare intron retention or read-through between two sample groups.", description="IRTools " + IRTools_VERSION + " -- compare NGS or ONT quantification results between two sample groups. IRI and RT support both formats; IRC supports NGS results.")

        # group for general arguments
        group_general = argparser_diff.add_argument_group( "general arguments" )
        group_general.add_argument( "-q", "--quant-type", dest = "quanttype", type = str, choices=("IRI", "IRC", "RT"),
                                  help = "Quantification input types: intron retention index (IRI), intron retention coefficient (IRC), and read-through index (RT). DEFAULT: \"IRI\".",
                                  default = "IRI")   
        group_general.add_argument("--indir", dest = "indir", type = str, default = '',
                                   help = "The directory containing the IR quantification result files to be analyzed. Default: the current working directory")
        group_general.add_argument("--input-format", dest = "inputformat", type = str, choices = ("auto", "NGS", "ONT"),
                                   help = "Quantification file format. \"auto\" detects .quant.* (NGS) or .ont.* files from their names. Use NGS or ONT when both formats exist for the same sample. DEFAULT: \"auto\".",
                                   default = "auto")
        group_general.add_argument( "-s1", "--s1-files", dest = "s1files", type = str, required = True,
                                    help = "A comma-separated list of sample or replicate names for group 1. IRI and RT accept .quant.* NGS or .ont.* ONT result files; IRC accepts .quant.* files." ) 
        group_general.add_argument( "-s2", "--s2-files", dest = "s2files", type = str, required = True,
                                    help = "A comma-separated list of sample or replicate names for group 2. IRI and RT accept .quant.* NGS or .ont.* ONT result files; IRC accepts .quant.* files." )
        group_general.add_argument( "-t", "--analysis-type", dest = "analysistype", type = str, choices = ("P", "U"),
                                  help = "Type of analysis performed. \"P\" is for paired replicates analysis and \"U\" is for unpaired replicates analysis. DEFAULT: \"U\".",
                                  default = "U" ) # Requires same sample size in each sample         
        group_general.add_argument( "-m", "--method", dest = "method", type = str, choices = ("minus", "log2fc"),
                                  help = "Method used for the reported change column. \"minus\" reports mean(S2) - mean(S1), and \"log2fc\" reports log2((mean(S2)+1e-6)/(mean(S1)+1e-6)). DEFAULT: \"minus\".",
                                  default = "minus" )

        group_general.add_argument( "-n", "--name", dest = "name", type = str, required = True,
                                    help = "Sample name, which will be used to generate output file names. REQUIRED.")  
        group_general.add_argument("--outdir", dest = "outdir", type = str, default = '',
                                   help = "If specified, all output files will be written to that directory. Default: the current working directory")          
        
        return


def elapsed_time(start_time, end_time):
        elapsed_sec = end_time - start_time
        h = int(elapsed_sec / (60 * 60))
        m = int((elapsed_sec % (60 * 60)) / 60)
        s = int(elapsed_sec % 60)
        return "{}:{:>02}:{:>02}".format(h, m, s)


if __name__ == '__main__':
        try:
                main()
        except KeyboardInterrupt:
                sys.stderr.write("User interrupted me!\n")
                sys.exit(0)
